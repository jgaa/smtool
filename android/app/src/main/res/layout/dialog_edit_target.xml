<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/target_name" />

    <EditText
        android:id="@+id/edit_target_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/target_name_hint"
        android:maxLength="32"
        android:inputType="text" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/pref_server_address" />

    <EditText
        android:id="@+id/edit_server_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="192.168.1.100"
        android:inputType="text" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/pref_server_port" />

    <EditText
        android:id="@+id/edit_server_port"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:text="45437" />

    <CheckBox
        android:id="@+id/check_transfer_enabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/pref_transfer_enabled" />

    <CheckBox
        android:id="@+id/check_delete_after_transfer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pref_delete_after_transfer" />

</LinearLayout>
